# Copy to .env and fill in. Never commit .env.

# Any OpenAI-compatible endpoint works.
# OpenAI:    https://api.openai.com/v1
# DeepSeek:  https://api.deepseek.com/v1
# Qwen:      https://dashscope.aliyuncs.com/compatible-mode/v1
# Moonshot:  https://api.moonshot.cn/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-your-key-here

# Optional. Only set this if your network needs a proxy to reach the provider.
# Leave it empty when using a provider that is directly reachable.
# LLM_PROXY=http://127.0.0.1:7890

# Set to 1 to run the rule-based classifier with no API key and no network.
DEMO_MODE=0

PORT=8000
